name: Simulated Jenkins CI

on:
  push:
    branches:
      - '**'
  pull_request:

jobs:
  build-and-test:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v3

      - name: Set up Java
        uses: actions/setup-java@v3
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Grant execute permissions to Gradle wrapper
        run: chmod +x ./gradlew

      - name: 🔨 Build
        run: ./gradlew assemble  # <-- This is your "Build" stage

      - name: ✅ Test
        run: ./gradlew test      # <-- This is your "Test" stage
